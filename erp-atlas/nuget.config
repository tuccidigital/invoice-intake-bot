<?xml version="1.0" encoding="utf-8"?>
<!-- Garante o nuget.org como origem de pacotes, mesmo em máquinas sem ele configurado globalmente. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
